{
  "name": "gpt-ai-assistant",
  "version": "6.1.0",
  "description": "Self-hosted LINE assistant powered by OpenAI, Supabase, and Google Calendar/Tasks",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanHsien/gpt-ai-assistant.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SanHsien/gpt-ai-assistant/issues"
  },
  "homepage": "https://github.com/SanHsien/gpt-ai-assistant#readme",
  "scripts": {
    "check:dependencies": "node tools/check-dependency-freshness.js",
    "check:dependabot-policy": "node tools/classify-dependabot-update.js",
    "db:migrate": "node scripts/migrate-database.js",
    "db:preflight": "node scripts/check-runtime.js",
    "db:configure-reminders": "node scripts/configure-reminder-cron.js",
    "db:rollback": "node scripts/rollback-database.js",
    "dev": "nodemon api/index.js",
    "start": "node api/index.js",
    "test": "jest",
    "test:module-load": "node --input-type=module -e \"await Promise.all([import('./services/reminders.js'), import('./services/runtime-preflight.js'), import('./contracts/google-provider.js')])\""
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.7.6",
    "axios": "^1.2.1",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.1",
    "form-data": "^4.0.0",
    "google-auth-library": "^10.9.1",
    "gpt-3-encoder": "^1.1.4",
    "html-to-text": "^10.0.0",
    "opencc-js": "^1.4.1",
    "pg": "^8.22.0",
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.4.1",
    "babel-jest": "30.4.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "jest": "30.4.2",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "@jest/reporters": {
      "glob": "13.0.6"
    },
    "babel-plugin-istanbul": {
      "test-exclude": "8.0.0"
    },
    "jest-config": {
      "glob": "13.0.6"
    },
    "jest-runtime": {
      "glob": "13.0.6"
    }
  }
}
